# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#   cp .env.example .env

# --- Identity / ownership ---
# UID/GID that owns the config + media files. Find yours with: id
# The container runs as this user so generated files aren't root-owned.
PUID=1000
PGID=1000

# IANA timezone, e.g. America/Chicago, Europe/London, Etc/UTC
TZ=Etc/UTC

# --- Image ---
# Pin a version tag instead of `latest` for reproducible redeploys.
JELLYFIN_IMAGE=lscr.io/linuxserver/jellyfin:latest

# --- Networking ---
# Host port for the Jellyfin web UI (container always listens on 8096).
HTTP_PORT=8096

# --- Paths (relative to this repo, or absolute) ---
# Defaults live inside the repo and are gitignored. Point MEDIA_DIR at your
# real library (or make ./media a symlink to it).
CONFIG_DIR=./config
MEDIA_DIR=./media
