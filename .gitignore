# --- Runtime state & secrets: never commit ---
# Real environment values (copy .env.example -> .env)
.env

# Jellyfin persistent data (generated by the container on first run:
# user db, device tokens, cached metadata/artwork). Instance-specific.
config/
cache/
transcodes/

# Media library (bind-mounted in; may be symlinks to real storage)
media/

# --- Cruft ---
*.log
.DS_Store
